rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Listings are publicly readable; only the owner can write
    match /listings/{listingId} {
      allow read: if true;
      allow create: if request.auth != null;
      // Any signed-in user can update rating/reviewCount (written by review transactions).
      // Only the owner can update listing content or delete.
      allow update: if request.auth != null
                    && (request.auth.uid == resource.data.createdBy
                       || resource.data.createdBy == 'seed'
                       || resource.data.createdBy == 'BG'
                       || request.resource.data.diff(resource.data)
                            .affectedKeys().hasOnly(['rating', 'reviewCount']));
      allow delete: if request.auth != null
                    && (request.auth.uid == resource.data.createdBy
                       || resource.data.createdBy == 'seed'
                       || resource.data.createdBy == 'BG');

      // Reviews: publicly readable, any signed-in user can add one
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if request.auth != null;
      }
    }

    // User profiles + bookmarks — only the owning user can read/write
    match /users/{uid} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid;

      match /bookmarks/{listingId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == uid;
      }
    }
  }
}
